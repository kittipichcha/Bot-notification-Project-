{
  "name": "notification-project",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "node --test tests/*.test.js",
    "check:env": "node --env-file-if-exists=.env packages/shared-config/check.js",
    "start:api": "node --env-file-if-exists=.env apps/api/dist/main.js",
    "dev:web": "npm run dev -w @notification/web"
  },
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  }
}
